{
  "simulation": {
    "refreshIntervalMs": 50
  },
  "canvas": {
    "backgroundColor": "#eef0f2",
    "minZoom": 0.5,
    "maxZoom": 3,
    "canvasWidth": 3000,
    "ductRows": {
      "initial": 2,
      "max": 10
    },
    "freeLayout": {
      "widthScale": 2,
      "heightScale": 5,
      "minWidth": 800,
      "minHeight": 1500,
      "growFactor": 1.5
    }
  },
  "wireDuct": {
    "slotWidth": 90,
    "slotHeight": 90,
    "color": "#d0d0d0",
    "borderColor": "#aaaaaa"
  },
  "wiring": {
    "electrical": {
      "thickness": 5,
      "colors": [
        "#e74c3c",
        "#f39c12",
        "#2ecc71",
        "#3498db",
        "#000000"
      ],
      "defaultColor": "#e74c3c",
      "labelFontSize": 12,
      "labelGap": 15
    },
    "pneumatic": {
      "thickness": 17,
      "colors": [
        "#2f6fd0",
        "#ac160e",
        "#1f2c34"
      ],
      "defaultColor": "#2f6fd0",
      "labelFontSize": 14,
      "labelGap": 15
    }
  },
  "render": {
    "terminalHoverColor": "#4a90d9",
    "terminalSelectedColor": "#ff6b6b",
    "hoverOpacityUnrelated": 0.1,
    "hoverOpacitySameGroup": 0.75
  },
  "multimeter": {
    "redProbe": {
      "fileName": "images/红表笔.png",
      "height": 180,
      "tipX": 97.5,
      "tipY": 0
    },
    "blackProbe": {
      "fileName": "images/黑表笔.png",
      "height": 180,
      "tipX": 0,
      "tipY": 0
    }
  },
  "rules": {
    "defaultConnectLimit": 2,
    "tripCurrent": 100,
    "faultLevels": [
      "简单",
      "中等",
      "困难"
    ]
  },
  "undo": {
    "maxSteps": 50
  },
