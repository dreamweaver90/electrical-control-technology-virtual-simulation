{
  "class": "SlideTableInstance",
  "category": "执行机构",
  "id": "slide_table",
  "name": "十字工作台",
  "description": "电机驱动的 XY 十字工作台（3D 悬浮视窗）。绑定两台电机分别驱动 X/Y 轴；可被位置开关/行程开关检测到位，可被电机绑定反馈堵转",
  "tags": [
    "执行机构",
    "十字滑台",
    "XY 平台",
    "3D"
  ],
  "singleton": true,
  "size": {
    "width": 200,
    "height": 200
  },
  "params": [
    {
      "id": "xMotor",
      "label": "X轴电机",
      "type": "bind",
      "allow": [
        "speed"
      ],
      "adjustable": true
    },
    {
      "id": "yMotor",
      "label": "Y轴电机",
      "type": "bind",
      "allow": [
        "speed"
      ],
      "adjustable": true
    },
    {
      "id": "strokeTimeX",
      "label": "X行程时间@1000rpm",
      "type": "number",
      "unit": "s",
      "min": 1,
      "max": 120,
      "step": 1,
      "default": 10,
      "adjustable": true
    },
    {
      "id": "strokeTimeY",
      "label": "Y行程时间@1000rpm",
      "type": "number",
      "unit": "s",
      "min": 1,
      "max": 120,
      "step": 1,
      "default": 10,
      "adjustable": true
    },
    {
      "id": "x_pos",
      "type": "number",
      "default": 0.5,
      "display": {
        "x": 100,
        "y": 42,
        "fontSize": 17,
        "color": "#58a6ff",
        "prefix": "X ",
        "scale": 100,
        "decimals": 0,
        "suffix": "%"
      }
    },
    {
      "id": "y_pos",
      "type": "number",
      "default": 0.5,
      "display": {
        "x": 100,
        "y": 68,
        "fontSize": 17,
        "color": "#3fb950",
        "prefix": "Y ",
        "scale": 100,
        "decimals": 0,
        "suffix": "%"
      }
    }
  ],
  "image": [
