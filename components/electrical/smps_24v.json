{
  "class": "RectifierInstance",
  "category": "电源",
  "id": "smps_24v",
  "name": "直流电源",
  "description": "整流器，AC 220V输入（l/n）、默认 DC 24V输出；输入须接 220V±15% 交流，闭合开关后输出才有电",
  "tags": [
    "电源",
    "整流器",
    "DC",
    "24V"
  ],
  "source": {
    "type": "dc",
    "voltage": 24,
    "pins": {
      "v+": 1,
      "v-": 0
    }
  },
  "input": {
    "pins": [
      "l",
      "n"
    ],
    "voltage": 220,
    "tolerance": 0.15
  },
  "params": [
    {
      "id": "inputVoltage",
      "label": "输入电压",
      "type": "number",
      "unit": "V",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 220
    },
    {
      "id": "outputVoltage",
      "label": "输出电压",
      "type": "number",
      "unit": "V",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 24,
      "adjustable": true
    },
    {
      "id": "sourceImpedance",
      "default": 0.05
    },
    {
      "id": "noLoadImpedance",
      "label": "空载电阻",
      "type": "number",
      "unit": "Ω",
      "min": 100,
      "max": 1000000,
      "step": 500,
      "default": 48400
    },
    {
      "id": "noLoadPowerFactor",
      "label": "空载功率因数",
      "type": "number",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 1
    },
    {
      "id": "minInputImpedance",
      "label": "最小折算阻抗",
      "type": "number",
      "unit": "Ω",
      "min": 1,
      "max": 1000,
      "step": 1,
      "default": 20
    },
    {
      "id": "dcResistance",
      "label": "输入直流电阻",
      "type": "number",
      "unit": "Ω",
      "min": 1000,
      "max": 10000000,
      "step": 1000,
      "default": 100000
    },
    {
      "id": "switch",
      "default": false
    },
    {
      "id": "energized",
      "default": false
    },
    {
      "id": "short_circuit",
      "default": false
    }
  ],
  "terminalHitRadius": 8,
  "zones": [
    {
      "id": "switch",
      "event": "click",
      "action": "toggle",
      "state": "switch",
      "tips": "电源开关，点击通电或断电",
