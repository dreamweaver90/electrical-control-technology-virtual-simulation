              "open",
              "stuck"
            ]
          }
        },
        "fwd_nc": {
          "pairs": [
            [
              "fwd_nc",
              "fwd_com"
            ]
          ],
          "when": "!fwd_act",
          "closeDelay": 1,
          "openDelay": 0,
          "fault": {
            "level": 0,
            "types": [
