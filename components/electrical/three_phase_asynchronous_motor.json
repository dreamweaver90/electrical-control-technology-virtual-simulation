{
  "class": "MotorInstance",
  "category": "电动机",
  "id": "three_phase_asynchronous_motor",
  "name": "三相异步电动机",
  "description": "三相异步电动机，三相绕组均可接线",
  "tags": [
    "电动机",
    "三相",
    "AC"
  ],
  "params": [
    {
      "id": "coilVoltage",
      "default": 380
    },
    {
      "id": "ratedConnection",
      "label": "额定接法",
      "type": "select",
      "options": [
        {
          "value": "Y",
          "label": "星形（Y）"
        },
        {
          "value": "D",
          "label": "三角形（Δ）"
        }
      ],
      "default": "Y",
      "adjustable": true
    },
    {
      "id": "minStartVoltage",
      "default": 0.4
    },
    {
      "id": "balanceTol",
      "default": 0.1
    },
    {
      "id": "phaseTol",
      "default": 10
    },
    {
      "id": "ratedPower",
      "label": "额定功率",
      "type": "number",
      "unit": "W",
      "min": 10,
      "max": 100000,
      "step": 10,
      "default": 370,
      "adjustable": true
    },
    {
      "id": "powerFactor",
      "label": "功率因数",
      "type": "number",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "adjustable": true
    },
    {
      "id": "lockRatio",
      "label": "堵转电流倍数",
      "type": "number",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "default": 6
    },
    {
      "id": "efficiency",
      "label": "效率",
      "type": "number",
      "min": 0.5,
      "max": 1,
      "step": 0.01,
      "default": 0.85,
      "adjustable": true
    },
    {
      "id": "ratedSpeed",
      "label": "额定转速",
      "type": "number",
      "unit": "rpm",
      "min": 100,
      "max": 6000,
      "step": 10,
      "default": 1400,
      "adjustable": true
    },
    {
      "id": "ratedCurrent",
      "label": "额定电流",
      "type": "number",
      "unit": "A",
      "decimals": 2,
      "readonly": true
    },
    {
      "id": "stallCurrent",
      "label": "堵转电流",
      "type": "number",
      "unit": "A",
      "decimals": 2,
      "readonly": true
    },
    {
      "id": "accelTimeOn",
      "label": "通电加速时间",
      "type": "number",
      "unit": "s",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "default": 0.6,
      "adjustable": true
    },
    {
      "id": "accelTimeOff",
      "label": "断电减速时间",
      "type": "number",
      "unit": "s",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "default": 2,
      "adjustable": true
    },
    {
      "id": "speed",
      "type": "number",
      "default": 0,
      "display": {
        "x": 80,
        "y": 55,
        "class": "speed-label",
        "suffix": " rpm",
        "decimals": 0,
        "when": "speed"
      }
    },
    {
      "id": "target",
      "label": "执行机构",
      "type": "bind",
      "allow": [
        "relative-position"
      ],
      "adjustable": true
    },
    {
      "id": "unit",
      "label": "执行单元",
      "type": "select",
      "options": "bound:target.relativePositions",
      "default": 0,
      "adjustable": true
    },
    {
      "id": "stalled",
      "type": "bool",
      "default": false,
      "display": {
        "x": 80,
        "y": 55,
        "fontSize": 22,
        "class": "stall-label",
        "trueText": "堵转",
        "when": "stalled"
      }
    },
    {
      "id": "dcResistance",
      "default": 370
    },
    {
      "id": "cw",
      "default": false
    },
    {
      "id": "ccw",
      "default": false
    },
    {
      "id": "name",
      "label": "名称",
      "type": "text",
      "default": "",
      "adjustable": true,
      "display": {
        "x": 79,
        "y": 90,
        "fontSize": 16,
        "class": "yellow-plate"
      }
    }
  ],
  "terminalHitRadius": 16,
  "size": {
    "width": 161,
    "height": 300
  },
  "image": [
