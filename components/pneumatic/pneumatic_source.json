{
  "class": "PressureSourceInstance",
  "category": "气动",
  "id": "pneumatic_source",
  "name": "气源",
  "description": "压缩空气气源（空压机），带开关。开关接通后出气口输出恒定气压（右键可设置，默认0.8MPa）。出气口空着通气会提示漏气。",
  "tags": [
    "气源",
    "空压机",
    "气动"
  ],
  "terminalHitRadius": 14,
  "size": {
    "width": 382,
    "height": 250
  },
  "pneumaticSource": {
    "outlets": [
      "out"
    ]
  },
  "zones": [
    {
      "id": "sw",
      "event": "click",
      "action": "toggle",
      "tips": "气源开关（接通/关闭）",
      "x": 170,
      "y": 103,
      "r": 30
    }
  ],
  "image": [
    {
      "id": "关机",
      "x": 0,
      "y": 0,
      "string": "<div><img src='images/气源.png' width='382' height='250'></div>",
      "bind": "!switch"
    },
    {
      "id": "通气",
      "x": 0,
      "y": 0,
      "string": "<div><img src='images/气源_通气.png' width='382' height='250'></div>",
      "bind": "switch"
    }
  ],
  "terminals": {
    "pneumatic": {
      "pins": {
        "out": {
          "x": 380,
          "y": 105,
          "tip": "出气口"
        }
      },
      "contacts": {},
      "loads": {},
      "permanent": {},
      "sensors": {}
    }
  },
  "params": [
    {
      "id": "pressure",
      "label": "出气压力",
      "type": "number",
      "unit": "MPa",
      "min": 0.1,
      "max": 1.6,
      "step": 0.05,
      "default": 0.8,
      "adjustable": true,
      "display": {
        "x": 190,
        "y": 167,
        "class": "pneu-pressure",
        "decimals": 2,
        "suffix": " MPa",
        "when": "switch"
      }
    },
    {
      "id": "switch",
      "type": "bool",
      "default": false
    }
  ]
}
